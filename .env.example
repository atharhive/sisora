# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/sisora?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin Account (used by seed script)
ADMIN_EMAIL="admin@sisora.si"
ADMIN_PASSWORD="change-this-strong-password"

# Email Delivery (Resend API - Free 3,000 emails/mo at https://resend.com)
# When set, any inquiry/offer sends an email notification to ADMIN_NOTIFICATION_EMAIL
# with "Reply-To" set to the prospective buyer's email so you can reply straight from your inbox.
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="sisorasales@gmail.com"
RESEND_FROM_EMAIL="Sisora Brokerage <onboarding@resend.dev>"
